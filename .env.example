# Public canonical site origin. Apple requires a registered HTTPS domain.
AUTH_BASE_URL=https://your-site.example

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Services ID plus the signing key created in Apple Developer.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Change for your Zoho data center, for example https://accounts.zoho.eu.
ZOHO_ACCOUNTS_ORIGIN=https://accounts.zoho.com
